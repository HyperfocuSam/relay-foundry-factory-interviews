# Copy to .env for Docker Compose. Replace these placeholders before starting.
POSTGRES_PASSWORD=replace-with-a-random-database-password
BOOTSTRAP_ADMIN_EMAIL=demo@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
APP_ORIGIN=http://localhost:3000

# Optional: set both to enable Gemini speech transcription and report drafting.
GEMINI_API_KEY=
GEMINI_MODEL=
# Direct Google API is the default. A relay is optional; configure both if used.
GEMINI_BASE_URL=
GEMINI_GATEWAY_KEY=


# External LiveKit server, required for live calls.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
