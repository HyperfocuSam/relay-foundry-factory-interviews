# Runtime env for the Cloud Run service (names only; values go to Secret Manager or --set-env-vars)
NODE_ENV=production                # set by Dockerfile
APP_ORIGIN=https://<your-service-url>   # MUST equal the browser origin exactly, no trailing slash
DATABASE_URL=<secret>
GEMINI_API_KEY=<secret>
GEMINI_MODEL=<gemini-... model id, confirm with the models list call>
# Leave UNSET on Cloud Run (us-central1 calls Google directly): GEMINI_BASE_URL, GEMINI_GATEWAY_KEY
# Optional (live calls; without them the app shows "Calls are not configured yet" and everything else works):
LIVEKIT_URL=wss://<project>.livekit.cloud
LIVEKIT_API_KEY=<secret>
LIVEKIT_API_SECRET=<secret>
# Migration job only (never on the service):
BOOTSTRAP_ADMIN_EMAIL=<demo login email for judges>
BOOTSTRAP_ADMIN_PASSWORD=<secret, 12-256 chars>
